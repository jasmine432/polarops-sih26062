# ==============================================================================
# PolarOps Backend (polar_logistics) Environment Configuration
# ==============================================================================

# PostgreSQL database connection string (standard psycopg2 connection URI).
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:password@localhost:5432/polar_logistics

# Secret key used for HMAC-SHA256 signing of JWT access tokens.
# Generate a cryptographically strong random string in production (e.g., openssl rand -hex 32).
POLAROPS_AUTH_SECRET=replace-with-a-secure-random-secret-key

# Comma-separated exact browser origins allowed to call the Python API.
# Replace with deployed frontend origin(s) in production; wildcard '*' is disallowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Target URL for the ML Inventory Forecast microservice.
# In local development, the ML service runs on port 8000.
ML_API_URL=http://127.0.0.1:8000/predict/inventory
